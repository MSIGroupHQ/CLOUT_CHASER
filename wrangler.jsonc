{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clout-chaser",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "bucket_name": "clout-chaser-media",
      "binding": "CLOUT_CHASER_MEDIA"
    }
  ],
  "routes": [
    {
      "pattern": "cloutchaser.prime88.studio",
      "custom_domain": true
    },
    {
      "pattern": "clout.prime88.studio",
      "custom_domain": true
    }
  ]
}
