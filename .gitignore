# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.tmp-browser/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Rust build artifacts
target/
worker/crates/*/target/
*.rlib
*.rmeta
*.d
*.wasm.map
*.pdb

# Wrangler
.wrangler/
wrangler-dev.*

# WASM compiled output (checked in separately if needed)
worker/src/trident_engine.wasm

# Large raw video dumps (keep key web clips)
public/media/video/*.MP4
public/media/video/*.mp4
!public/media/video/runway-clout-chaser-launch-30s-20260731-151332.mp4
